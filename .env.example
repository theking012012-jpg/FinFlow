# FinFlow — Environment Variables
# Copy this file to .env and fill in your values before deploying.
# NEVER commit .env to git.

# ── Required — app will not start without these ───────────────────────────────

# PostgreSQL connection string. Local example: postgres://postgres:password@localhost:5432/finflow
# Render/Railway/Supabase will provide this automatically.
DATABASE_URL=postgres://user:password@host:5432/finflow

# Anthropic API key — powers the AI assistant and receipt scanner.
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# A long, random secret string used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# (M1) Dedicated key for encrypting stored connector credentials (Plaid/Finch/Stripe/WiPay/…),
# INDEPENDENT of SESSION_SECRET so you can rotate the session secret without bricking connectors.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Migration: set this, then re-save each connected integration once (re-encrypts it under the new
# key); existing credentials keep decrypting via the SESSION_SECRET fallback until they're re-saved.
# If unset, the app falls back to the legacy SESSION_SECRET-derived key (no behaviour change).
CONNECTOR_ENC_KEY=replace-with-a-long-random-string

# The exact origin your frontend runs on (e.g. https://finflow-production-dab2.up.railway.app).
# Used to lock down CORS. In development you can leave this unset.
ALLOWED_ORIGIN=https://finflow-production-dab2.up.railway.app

# ── Optional ──────────────────────────────────────────────────────────────────

# Set to 'production' on your server to enable secure cookies and other guards.
NODE_ENV=production

# Port the server listens on (defaults to 3000 if unset).
PORT=3000

# ── Email — Password Reset (Resend) ──────────────────────────────────────────
# Sign up free at https://resend.com — get an API key in ~2 minutes.
# Without this, reset links are logged to the server console instead of emailed.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The sender address shown in reset emails. Must be a verified domain in Resend.
EMAIL_FROM=FinFlow <noreply@yourdomain.com>

# The public URL of your app, used to build every outbound email/redirect link (F29).
# Single source of truth — set this to your canonical public origin.
APP_URL=https://finflow-production-dab2.up.railway.app

# ── Stripe — Billing ──────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys and your product price IDs.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# ── Cron jobs ─────────────────────────────────────────────────────────────────
# Random secret used to authenticate scheduled cron requests.
CRON_SECRET=your_random_secret_here

# ── Admin ─────────────────────────────────────────────────────────────────────
# Password to log into the /admin panel. Set a strong value before deploying.
ADMIN_PASSWORD=your_secure_admin_password_here
# Email address that receives new accountant application notifications.
ADMIN_EMAIL=admin@yourdomain.com

# ── Observability & indexing ────────────────────────────────────────────────────
# Sentry DSN for error / exception tracking. LEAVE BLANK to disable (the app runs fine
# without it; it just won't report). Activate by `npm i @sentry/node` and setting this.
SENTRY_DSN=
# Structured JSON access logging (one line per request, with X-Request-Id). 1/true/yes = on.
# Off by default to keep logs quiet; turn on in production for request tracing.
LOG_REQUESTS=
# Search-engine indexing gate. Default (blank) serves `noindex` + `Disallow: /` so the app
# is NOT indexed while testing. Set ALLOW_INDEXING=1 AT LAUNCH to allow crawlers.
ALLOW_INDEXING=

# ── Least-privilege deploys (F202) ───────────────────────────────────────────────
# Set to 1 ONLY on the web process when it runs as the least-privilege DB role (finflow_app,
# from scripts/db-app-role.sql), which has no DDL rights. Schema + migrations must then be applied
# by a separate owner-run release step:  DATABASE_URL="$OWNER_URL" node scripts/migrate.js
# Leave BLANK for the default (boot applies schema + migrations itself, needs an owner/DDL role).
SKIP_INIT_DDL=

# ── CSP nonce/hash migration (measurement) ───────────────────────────────────────
# Set to 1 to ALSO emit a strict Content-Security-Policy-Report-Only (no 'unsafe-inline') that BLOCKS
# NOTHING but reports every inline script/handler/style to /api/csp-report. Browse the app, then read
# the aggregate at GET /api/csp-report (owner-only) to get the exact fix-list before hardening the
# enforced CSP. Leave BLANK in normal operation (off — no reports, no overhead).
CSP_REPORT_ONLY=
